rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: history
    // Document ID: {analysisId}
    // Fields:
    //   - userId: string (required) - The user ID who owns this analysis.
    //   - timestamp: string (required, ISO 8601) - When the analysis was performed.
    //   - frontImage: string (optional) - Base64 encoded front view image.
    //   - sideImage: string (optional) - Base64 encoded side view image.
    //   - score: number (required) - Overall posture score.
    //   - riskLevel: string (required, enum: ["低", "中", "高"]) - Calculated risk level.
    //   - summary: string (optional) - Professional summary.
    //   - alignment: map (optional) - Detailed alignment analysis.
    //   - metrics: map (optional) - Key posture metrics.
    //   - scoreBreakdown: map (optional) - Breakdown of the overall score.
    //   - recommendations: list (optional) - List of recommendations.
    //   - exercises: list (optional) - Recommended exercises.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "roypublicmail20@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidAnalysis(data) {
      return data.userId is string &&
             data.timestamp is string &&
             data.score is number &&
             data.riskLevel in ["低", "中", "高"];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /history/{analysisId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidAnalysis(request.resource.data);
      allow update: if isDocOwner() && isValidAnalysis(request.resource.data) && request.resource.data.userId == resource.data.userId;
      allow delete: if isDocOwner() || isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }
  }
}
